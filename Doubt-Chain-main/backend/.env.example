NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/doubt_chain

# Auth (cookie/JWT foundation)
JWT_SECRET=change-me-in-dev

# CORS
CLIENT_ORIGIN=http://localhost:5173

# ── Semantic search: embeddings (backend-only secrets) ────────────────
# Provider: openai (OpenAI-compatible: OpenAI, Together, Ollama /v1, OpenRouter),
#           gemini (Google Generative Language API),
#           huggingface (Inference API feature-extraction).
# Leave EMBEDDING_API_KEY empty to run keyword-only search (the API reports
# `degraded: true` instead of pretending semantic search works).
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the pgvector column dimension (migration uses vector(1536)).
EMBEDDING_DIMENSIONS=1536
# Optional: override the API base URL (e.g. http://localhost:11434/v1 for Ollama,
# https://generativelanguage.googleapis.com/v1beta for Gemini,
# https://api-inference.huggingface.co for Hugging Face).
# EMBEDDING_BASE_URL=
# EMBEDDING_BATCH_SIZE=16

# ── AI Doubt Assistant: chat model (backend-only secrets) ─────────────
# Provider: openai | gemini | groq. Leave LLM_API_KEY empty to disable the
# assistant; /ai/ask then returns 503 AI_NOT_CONFIGURED (no fake answers).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=900
AI_REQUEST_TIMEOUT_MS=20000

# ── Retrieval + safety knobs ──────────────────────────────────────────
AI_MAX_CONTEXT_DOUBTS=5
AI_RATE_LIMIT_PER_MINUTE=10
# Generic per-IP budget for every API route (15-minute window)
GLOBAL_RATE_LIMIT_MAX=300
SEARCH_RATE_LIMIT_PER_MINUTE=60
SEMANTIC_MIN_SCORE=0.25
SEMANTIC_SIMILAR_MIN_SCORE=0.45
SEMANTIC_SEARCH_ENABLED=true
EMBEDDING_AUTO_INDEX=true

# Media (Cloudinary) - used in later phase
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

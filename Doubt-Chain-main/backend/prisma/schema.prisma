// Prisma schema for Doubt-Chain
// Designed from PRD: User, Subject, Doubt, Answer, upvote representation

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector powers semantic search / RAG retrieval (see Docs/11-ai-implementation.md).
  // The extension is created by migration 20261027120000_pgvector_extension.
  extensions = [vector]
}

enum Profession {
  STUDENT
  PROFESSOR
  CORPORATE_WORKER
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  username              String     @unique
  displayName           String
  fullName              String?
  profession            Profession?
  identificationNumber  String?
  passwordHash          String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  doubts         Doubt[]
  answers        Answer[]
  upvotes        AnswerUpvote[]
  aiInteractions AiInteraction[]

  @@index([profession])
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doubts Doubt[]
}

model Doubt {
  id          String   @id @default(cuid())
  title       String
  content     String
  mediaUrl    String?
  mediaType   MediaType?
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  answers   Answer[]
  embedding DoubtEmbedding?

  @@index([subjectId, isResolved, createdAt])
  @@index([authorId])
}

model Answer {
  id        String   @id @default(cuid())
  content   String
  mediaUrl  String?
  mediaType MediaType?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  doubtId String
  doubt   Doubt  @relation(fields: [doubtId], references: [id], onDelete: Cascade)

  upvotes AnswerUpvote[]

  @@index([doubtId, createdAt])
  @@index([authorId])
}

model AnswerUpvote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, answerId])
  @@index([answerId])
}

enum MediaType {
  IMAGE
  AUDIO
}

/// Vector index row for semantic search / RAG retrieval.
///
/// `embedding` is a pgvector column managed through raw SQL (Prisma models
/// `vector` as an Unsupported type). 1536 dimensions matches OpenAI
/// text-embedding-3-small; other providers are padded/trimmed to fit.
/// Rows are created/updated by the embedding indexer and are safe to delete:
/// the index can always be rebuilt from the Doubt table.
model DoubtEmbedding {
  id          String                     @id @default(cuid())
  doubtId     String                     @unique
  doubt       Doubt                      @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  provider    String
  model       String
  dimensions  Int
  contentHash String
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([model])
  @@index([provider])
}

/// Audit trail of AI assistant calls (prompt is stored, secrets never are).
model AiInteraction {
  id        String   @id @default(cuid())
  mode      String
  question  String
  answer    String
  grounded  Boolean  @default(false)
  provider  String?
  model     String?
  latencyMs Int?
  sources   Json?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  doubtId String?

  @@index([userId, createdAt])
  @@index([createdAt])
}
